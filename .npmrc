# GitHub Packages registry — scope this to your GitHub org/username
# Replace neelameghashyam with your actual GitHub username or org (must match package.json "name" scope)
@neelameghashyam:registry=https://npm.pkg.github.com

# Auth token — do NOT commit a real token. Use an env var instead:
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
