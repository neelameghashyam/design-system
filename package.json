{
  "name": "core-ds",
  "version": "0.1.1",
  "private": true,
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "vite --config projects/playground/vite.config.ts",
    "build": "vite build --config projects/ui-kit/vite.config.ts",
    "storybook": "storybook dev -p 6006 -c projects/ui-kit/.storybook",
    "build:storybook": "storybook build -c projects/ui-kit/.storybook -o dist/storybook",
    "test": "vitest run --config projects/ui-kit/vitest.config.ts",
    "generate": "node tools/generate.mjs",
    "publish:package": "cd projects/ui-kit && npm publish"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.5.0",
    "@storybook/addon-docs": "^8.5.0",
    "@storybook/vue3": "^8.5.0",
    "@storybook/vue3-vite": "^8.5.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^25.0.0",
    "sass": "^1.94.0",
    "storybook": "^8.5.0",
    "typescript": "~5.7.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.0"
  }
}
